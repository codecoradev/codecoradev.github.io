{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeCoraDev CLA Signatures",
  "description": "Schema for .cla/signatures.json consumed by the org-level cla-check workflow",
  "type": "object",
  "required": ["version", "signatures"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "github_username", "signed_at", "cla_type", "commit_sha", "signature"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "github_username": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "signed_at": { "type": "string", "format": "date-time" },
          "cla_type": { "enum": ["individual", "corporate"] },
          "commit_sha": { "type": "string" },
          "signature": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
